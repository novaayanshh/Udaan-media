PORT=5000

# SMTP settings for sending enquiry emails (optional).
# If left blank, the server still saves every submission to server/data/submissions.json
# and the API keeps working — it just won't email anyone.
#
# Example for Gmail: use an "App Password" (not your normal password),
# generate one at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Who receives the enquiry emails, and what "From" address to use
MAIL_TO=hello@digyudaan.com
MAIL_FROM=youraddress@gmail.com

# Set this to view saved leads at GET /api/submissions?key=YOUR_ADMIN_KEY
ADMIN_KEY=3feea69779b5a69396e50742